model Request {
  id         String @id @default(uuid())
  tenantId   String
  propertyId String

  message String?
  status  RequestStatus @default(MOVE_IN_REQUESTED)

  securityDeposit  Decimal   @db.Decimal(10, 2)
  monthlyRent      Decimal   @db.Decimal(10, 2)
  moveInApprovedAt DateTime?
  moveInDate       DateTime

  moveOutDate       DateTime?
  damageAmount      Decimal?  @db.Decimal(10, 2)
  moveOutApprovedAt DateTime?
  completedAt       DateTime?

  rejectedReason String?
  rejectedAt     DateTime?

  payments Payment[]
  review   Review?

  tenant   User     @relation("TenantRequests", fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
  @@map("requests")
}
